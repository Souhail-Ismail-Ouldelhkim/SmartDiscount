<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
	<RootNamespace>SmartDiscount.Ordering.API</RootNamespace>
  </PropertyGroup>


	<ItemGroup>
		<Compile Include="..\Shared\ActivityExtensions.cs" Link="Extensions\ActivityExtensions.cs" />
		<Compile Include="..\Shared\MigrateDbContextExtensions.cs" Link="Extensions\MigrateDbContextExtensions.cs" />
	</ItemGroup>


	<ItemGroup>
      <ProjectReference Include="..\SmartDiscount.EventBusServiceBus\SmartDiscount.EventBusServiceBus.csproj" />
	  <ProjectReference Include="..\SmartDiscount.IntegrationEventLogEF\SmartDiscount.IntegrationEventLogEF.csproj" />
	  <ProjectReference Include="..\SmartDiscount.Ordering.Domain\SmartDiscount.Ordering.Domain.csproj" />
	  <ProjectReference Include="..\SmartDiscount.Ordering.Infrastructure\SmartDiscount.Ordering.Infrastructure.csproj" />
	  <ProjectReference Include="..\SmartDiscount.ServiceDefaults\SmartDiscount.ServiceDefaults.csproj" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Asp.Versioning.Http" />
		<PackageReference Include="Aspire.Npgsql.EntityFrameworkCore.PostgreSQL" />
		<PackageReference Include="FluentValidation" />
		<PackageReference Include="FluentValidation.DependencyInjectionExtensions" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Tools">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
	</ItemGroup>

	<ItemGroup>
		<Content Update="appsettings.Development.json">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<ExcludeFromSingleFile>true</ExcludeFromSingleFile>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
	</ItemGroup>
	
</Project>
