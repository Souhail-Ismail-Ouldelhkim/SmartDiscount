{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
      "principalId": {
        "value": "${AZURE_PRINCIPAL_ID}"
      },
      "ChatModelParameter": {
        "value": "${AZURE_CHAT_MODEL_PARAMETER}"
      },
      "EmbeddingModelParameter": {
        "value": "${AZURE_EMBEDDING_MODEL_PARAMETER}"
      },
      "OpenAIKeyParameter": {
        "value": "${AZURE_OPEN_AIKEY_PARAMETER}"
      },
      "postgres_password": {
        "value": "${AZURE_POSTGRES_PASSWORD}"
      },
      "postgres_username": {
        "value": "${AZURE_POSTGRES_USERNAME}"
      },
      "redis_password": {
        "value": "${AZURE_REDIS_PASSWORD}"
      },
      "environmentName": {
        "value": "${AZURE_ENV_NAME}"
      },
      "location": {
        "value": "${AZURE_LOCATION}"
      }
    }
  }
  