@model SmartDiscount.Identity.API.Models.PasswordViewModels.ForgotPasswordViewModel

<link rel="stylesheet" href="~/css/reset.css" />

<div class="sd-reset">
    <form asp-controller="Password" asp-action="ForgotPassword" method="post" class="sd-card">
        <input type="hidden" name="returnUrl" value="@ViewData["ReturnUrl"]" />

        <div class="sd-logo"><span class="sd-tag">%</span> Smart<span>Discount</span></div>

        <div class="sd-icon-circle">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#1a2b4a" stroke-width="2">
                <rect x="3" y="11" width="18" height="11" rx="2" />
                <path d="M7 11V7a5 5 0 0 1 10 0v4" />
                <circle cx="12" cy="16" r="1.5" fill="#d4a017" stroke="none" />
            </svg>
        </div>

        <div class="sd-title">Forgot password?</div>
        <div class="sd-subtitle">No worries. Enter your email and we'll send you a 4-digit code to reset your password.</div>

        <partial name="_ValidationSummary" />

        <div class="sd-field">
            <label asp-for="Email">Email address</label>
            <div class="sd-input-icon">
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#888" stroke-width="2">
                    <rect x="2" y="4" width="20" height="16" rx="2" />
                    <path d="m22 7-10 5L2 7" />
                </svg>
                <input class="sd-input" placeholder="name@email.com" asp-for="Email" autofocus>
            </div>
        </div>

        <button class="sd-btn" type="submit">Send reset code</button>

        <div class="sd-footer">
            <span>Remember your password?</span>
            <a class="sd-link" asp-controller="Account" asp-action="Login">Back to login</a>
        </div>
    </form>
</div>