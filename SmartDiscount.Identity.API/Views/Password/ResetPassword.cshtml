@model SmartDiscount.Identity.API.Models.PasswordViewModels.ResetPasswordViewModel

<link rel="stylesheet" href="~/css/reset.css" />

<div class="sd-reset">
    <form asp-controller="Password" asp-action="ResetPassword" method="post" class="sd-card">
        <input type="hidden" asp-for="Email" />

        <div class="sd-logo"><span class="sd-tag">%</span> Smart<span>Discount</span></div>

        <div class="sd-title" style="text-align:left">Reset password</div>
        <div class="sd-subtitle" style="text-align:left">Choose a new password for your account.</div>

        <partial name="_ValidationSummary" />

        <div class="sd-field">
            <label asp-for="Password">New password</label>
            <input type="password" class="sd-input" placeholder="New password" asp-for="Password">
        </div>

        <div class="sd-field">
            <label asp-for="ConfirmPassword">Confirm new password</label>
            <input type="password" class="sd-input" placeholder="Re-enter new password" asp-for="ConfirmPassword">
        </div>

        <div class="sd-hint" style="text-align:left">Min. 6 characters.</div>

        <button class="sd-btn" type="submit">Reset password</button>

        <div class="sd-footer">
            <span>Remember your password?</span>
            <a class="sd-link" asp-controller="Account" asp-action="Login">Back to login</a>
        </div>
    </form>
</div>