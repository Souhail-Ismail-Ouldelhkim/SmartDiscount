@model SmartDiscount.Identity.API.Models.AccountViewModels.RegisterViewModel

<link rel="stylesheet" href="~/css/register.css" />

<div class="sd-register">
    <form asp-controller="Account" asp-action="Register" method="post" class="sd-card">
        <input type="hidden" asp-for="ReturnUrl" />
        <input type="hidden" asp-for="CardType" id="CardType" value="1" />

        <div class="sd-logo"><span class="sd-tag">%</span> Smart<span>Discount</span></div>
        <span class="sd-step-badge" id="sd-step-badge">Step 1 / 2</span>
        <div class="sd-title">Create account</div>
        <div class="sd-subtitle">Account &amp; payment details</div>

        <div class="sd-progress" id="sd-progress">
            <div class="sd-dot">1</div>
            <div class="sd-line"><div class="sd-fill"></div></div>
            <div class="sd-dot">2</div>
        </div>
        <div class="sd-plabels"><span>Account</span><span>Payment</span></div>

        <partial name="_ValidationSummary" />

        <div id="sd-step1">
            <div class="sd-grid">
                <div class="sd-field">
                    <label asp-for="Name"></label>
                    <input class="sd-input" id="Name" placeholder="First name" asp-for="Name" autofocus>
                </div>
                <div class="sd-field">
                    <label asp-for="LastName"></label>
                    <input class="sd-input" id="LastName" placeholder="Last name" asp-for="LastName">
                </div>
            </div>
            <div class="sd-field">
                <label asp-for="UserName"></label>
                <input class="sd-input" id="UserName" placeholder="Choose a username" asp-for="UserName">
            </div>
            <div class="sd-field">
                <label asp-for="Email"></label>
                <input class="sd-input" id="Email" placeholder="name@email.com" asp-for="Email">
            </div>
            <div class="sd-field">
                <label asp-for="PhoneNumber"></label>
                <input class="sd-input" id="PhoneNumber" placeholder="+41 00 000 00 00" asp-for="PhoneNumber">
            </div>
            <div class="sd-field">
                <label asp-for="Street"></label>
                <input class="sd-input" id="Street" placeholder="Street and number" asp-for="Street">
            </div>
            <div class="sd-grid">
                <div class="sd-field">
                    <label asp-for="City"></label>
                    <input class="sd-input" id="City" placeholder="City" asp-for="City">
                </div>
                <div class="sd-field">
                    <label asp-for="State"></label>
                    <input class="sd-input" id="State" placeholder="State" asp-for="State">
                </div>
                <div class="sd-field">
                    <label asp-for="ZipCode"></label>
                    <input class="sd-input" id="ZipCode" placeholder="Zip code" asp-for="ZipCode">
                </div>
            </div>
            <div class="sd-field">
                <label asp-for="Country"></label>
                <select class="sd-select" id="Country" asp-for="Country">
                    <option value="">Select your country</option>
                    <option value="Switzerland">Switzerland</option>
                    <option value="France">France</option>
                    <option value="Tunisia">Tunisia</option>
                    <option value="Morocco">Morocco</option>
                    <option value="U.S.">United States</option>
                </select>
            </div>
            <div class="sd-grid">
                <div class="sd-field">
                    <label asp-for="Password"></label>
                    <input type="password" class="sd-input" id="Password" placeholder="Password" asp-for="Password">
                </div>
                <div class="sd-field">
                    <label asp-for="ConfirmPassword"></label>
                    <input type="password" class="sd-input" id="ConfirmPassword" placeholder="Confirm password" asp-for="ConfirmPassword">
                </div>
            </div>
            <button type="button" class="sd-btn" id="sd-next-btn">Next →</button>
        </div>

        <div id="sd-step2">
            <div class="sd-field">
                <label asp-for="CardHolderName"></label>
                <input class="sd-input" placeholder="Name on card" asp-for="CardHolderName">
            </div>
            <div class="sd-field">
                <label asp-for="CardNumber"></label>
                <input class="sd-input" placeholder="0000 0000 0000 0000" asp-for="CardNumber">
            </div>
            <div class="sd-field">
                <label>Card type</label>
                <div class="sd-input sd-cardtype-btn" id="sd-cardtype-open">
                    <span id="sd-cardtype-label">Visa</span>
                    <span>▼</span>
                </div>
            </div>
            <div class="sd-grid">
                <div class="sd-field">
                    <label asp-for="Expiration"></label>
                    <input class="sd-input" placeholder="MM/YY" asp-for="Expiration">
                </div>
                <div class="sd-field">
                    <label asp-for="SecurityNumber"></label>
                    <input class="sd-input" placeholder="CVC" asp-for="SecurityNumber">
                </div>
            </div>
            <button type="submit" class="sd-btn">Create account</button>
            <button type="button" class="sd-back" id="sd-back-btn">← Back to previous step</button>
        </div>

        <div class="sd-footer">
            <span>Already have an account?</span>
            <a class="sd-link" asp-controller="Account" asp-action="Login">Login</a>
        </div>
    </form>
</div>

<div class="sd-modal-overlay" id="sd-cardtype-modal">
    <div class="sd-modal">
        <h3>Select card type</h3>
        <div class="sd-modal-option" data-value="1" data-label="Visa">💳 Visa</div>
        <div class="sd-modal-option" data-value="2" data-label="Mastercard">💳 Mastercard</div>
        <div class="sd-modal-option" data-value="3" data-label="American Express">💳 American Express</div>
        <button type="button" class="sd-back" id="sd-cardtype-cancel">Cancel</button>
    </div>
</div>

@section scripts {
    <script src="~/js/register.js" asp-append-version="true"></script>
}